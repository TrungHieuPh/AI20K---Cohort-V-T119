# Copy to .env. Never commit .env.

# --- Law index (core/ingest.py, core/retrieve.py) ---
# Local embedding model; downloaded to the Hugging Face cache on first use (~4.3 GB). Only needed to embed queries; the index itself is built from data/law/dieu.BAAI__bge-m3.npz.
EMBED_MODEL=BAAI/bge-m3
# Qdrant local mode: index stored in this folder (git-ignored). One process at a time.
QDRANT_PATH=.qdrant
QDRANT_COLLECTION=labor_code__bge-m3__dieu
# Leave empty for local mode. Set to use a Qdrant server, e.g. http://localhost:6333
QDRANT_URL=
QDRANT_API_KEY=
