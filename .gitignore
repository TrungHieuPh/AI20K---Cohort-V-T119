# Secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Blind test: the answer key and test set stay with Khoa, never committed
**/answer_key*.csv
data/test/test_set*.csv

# Khoa's private sentence-highlighting benchmark (inputs and answer keys)
/data/test/bo_de_boi_do_kin/

# Local vector index and run outputs
# (.qdrant*/ also covers a custom QDRANT_PATH such as .qdrant_test/)
.qdrant*/
results*.json
results*.csv
results_toi_uu/
*.log

# Embedding model cache, if HF_HOME is pointed inside the repo
.cache/
hf_cache/

# Working files kept outside the repo (question-writing helper spreadsheets)
data/**/*.xlsx

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# Editors
.vscode/
.idea/

# OS and Office lock files (opening data/law/*.doc in Word creates ~$ files)
.DS_Store
Thumbs.db
~$*
